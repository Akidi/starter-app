# .dockerignore - Place in project root (same directory as docker-compose.yml)

# CRITICAL: Exclude node_modules to prevent copying large dependencies
node_modules/
.pnpm-store/

# Build outputs and artifacts  
build/
dist/
.output/
.vercel/
.netlify/
.adapter-*/
.svelte-kit/
.vite/

# Environment files
.env*
!.env.example

# Logs and cache
logs/
*.log
.cache/
.parcel-cache/
.turbo/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git
.git/
.gitignore
.gitattributes

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
*.md
!README.md
docs/

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
**/__tests__/
**/*.test.ts
**/*.spec.ts

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Temporary files
tmp/
temp/
*.tmp