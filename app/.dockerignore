# .dockerignore - Place this file in /app/.dockerignore (same directory as Dockerfile)

# CRITICAL: Exclude node_modules to prevent overwriting installed dependencies
node_modules

# Build outputs and artifacts  
build/
dist/
.output/
.vercel/
.netlify/
.adapter-*/
.svelte-kit/

# Environment files
.env*
!.env.example

# Logs and cache
logs/
*.log
.cache/
.parcel-cache/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
*.md
!README.md

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/