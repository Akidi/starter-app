# Redis ACL Configuration
# Comments are stripped from generated files (Redis ACL doesn't support them)

# Permission Categories:
# ~* = all keys, &* = all channels
# +@all = all commands
# +@read = get, mget, hgetall, lrange, smembers, etc.
# +@write = set, del, lpush, sadd, zadd, etc.
# +@string, +@hash, +@list, +@set, +@sortedset, +@stream = specific data type commands
# +@connection = ping, echo, select, client commands (required by ioredis)
# +info = INFO command (used by ioredis health checks)
# +client = CLIENT commands (used by ioredis for connection naming)
# +select = SELECT command (database selection)
# -@admin = blocks CONFIG, SHUTDOWN, REPLICAOF, etc.
# -@dangerous = blocks FLUSHALL, FLUSHDB, KEYS, DEBUG, INFO, etc.
# IMPORTANT: When using -@dangerous, add +info at the END to re-enable it

# Default user - disabled for security
user default on >{{REDIS_DEFAULT_USER_PASSWORD}}

# Admin - full access
user archon on >{{ADMIN_USER_REDIS_PASSWORD}} ~* &* +@all

# Developer - read/write with connection management
user runesmith on >{{DEVELOPER_USER_REDIS_PASSWORD}} ~* &* -@all +@read +@write +@string +@hash +@list +@set +@sortedset +@stream +@connection +client +info

# API user - runtime access (needs +info +client +select for ioredis)
user tinkerer on >{{API_USER_REDIS_PASSWORD}} ~* &* -@all +@read +@write +@string +@hash +@list +@set +@sortedset +@connection +client +select +info +scan

# Read-only - reporting and monitoring
user lorekeeper on >{{READONLY_USER_REDIS_PASSWORD}} ~* &* -@all +@read +@connection +info

# Backup - read-only with connection info
user stoneguard on >{{BACKUP_USER_REDIS_PASSWORD}} ~* &* -@all +@read +@connection +info

# Auditor - security monitoring
user seer on >{{AUDITOR_USER_REDIS_PASSWORD}} ~* &* -@all +@read +@connection +client +info