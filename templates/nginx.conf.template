# Nginx Configuration for {{APP_NAME}}
#
# Installation:
#   1. Install Nginx: sudo apt install nginx
#   2. Copy this file: sudo cp nginx.conf.template /etc/nginx/sites-available/{{APP_NAME}}
#   3. Edit the domain and port below
#   4. Create symlink: sudo ln -s /etc/nginx/sites-available/{{APP_NAME}} /etc/nginx/sites-enabled/
#   5. Test config: sudo nginx -t
#   6. Reload Nginx: sudo systemctl reload nginx
#
# SSL Setup with Let's Encrypt:
#   1. Install Certbot: sudo apt install certbot python3-certbot-nginx
#   2. Get certificate: sudo certbot --nginx -d {{DOMAIN}}
#   3. Certbot will automatically update this file with SSL configuration
#
# Replace {{DOMAIN}} with your actual domain (e.g., app.example.com)
# Replace {{APP_PORT}} with your app port (default: 5175 for production)

# Rate limiting zones
limit_req_zone $binary_remote_addr zone=app_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

# Upstream backend
upstream {{APP_NAME}}_backend {
    server localhost:{{APP_PORT}} fail_timeout=5s max_fails=3;

    # If you have multiple app instances, add them here:
    # server localhost:5176 fail_timeout=5s max_fails=3;
    # server localhost:5177 fail_timeout=5s max_fails=3;

    # Connection keepalive
    keepalive 32;
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}} www.{{DOMAIN}};

    # Let's Encrypt challenge location
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /var/www/letsencrypt;
    }

    # Redirect all other traffic to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{DOMAIN}};

    # SSL certificate paths (will be configured by certbot)
    # ssl_certificate /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;

    # SSL configuration (Mozilla Intermediate - compatible with most clients)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;

    # SSL session cache
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # OCSP stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    # ssl_trusted_certificate /etc/letsencrypt/live/{{DOMAIN}}/chain.pem;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Remove nginx version
    server_tokens off;

    # Connection limits
    limit_conn conn_limit 20;

    # Logging
    access_log /var/log/nginx/{{APP_NAME}}.access.log combined;
    error_log /var/log/nginx/{{APP_NAME}}.error.log warn;

    # Client body size limit
    client_max_body_size 10M;

    # Timeouts
    client_body_timeout 12s;
    client_header_timeout 12s;
    send_timeout 10s;
    keepalive_timeout 65s;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        application/rss+xml
        image/svg+xml;

    # Health check endpoint (no rate limiting, no logging)
    location /health {
        access_log off;
        proxy_pass http://{{APP_NAME}}_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
    }

    # Static assets with aggressive caching
    location ~ ^/_app/ {
        proxy_pass http://{{APP_NAME}}_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Cache static assets for 1 year
        add_header Cache-Control "public, max-age=31536000, immutable";

        # Security headers (inherited from server block but repeated for clarity)
        add_header X-Content-Type-Options "nosniff" always;

        expires 1y;
    }

    # API endpoints (higher rate limit)
    location ~ ^/api/ {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass http://{{APP_NAME}}_backend;
        proxy_http_version 1.1;

        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";

        # Timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }

    # Main application
    location / {
        limit_req zone=app_limit burst=10 nodelay;

        proxy_pass http://{{APP_NAME}}_backend;
        proxy_http_version 1.1;

        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;

        # WebSocket support (if needed)
        proxy_redirect off;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Deny access to sensitive files
    location ~ \.(env|git|gitignore|htaccess|htpasswd)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
}

# Redirect www to non-www (optional)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.{{DOMAIN}};

    # SSL certificates (same as main domain)
    # ssl_certificate /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;

    return 301 https://{{DOMAIN}}$request_uri;
}
