# Caddy v2 Configuration for {{APP_NAME}}
# This configuration provides automatic HTTPS with Let's Encrypt
#
# Installation:
#   1. Install Caddy: https://caddyserver.com/docs/install
#   2. Copy this file: sudo cp Caddyfile.template /etc/caddy/Caddyfile
#   3. Edit the domain and port below
#   4. Reload Caddy: sudo systemctl reload caddy
#
# Replace {{DOMAIN}} with your actual domain (e.g., app.example.com)
# Replace {{APP_PORT}} with your app port (default: 5175 for production)

{{DOMAIN}} {
    # Automatic HTTPS via Let's Encrypt
    # Certificates are automatically obtained and renewed

    # Enable compression
    encode gzip zstd

    # Security headers
    header {
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"

        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"

        # XSS protection (legacy, but doesn't hurt)
        X-XSS-Protection "1; mode=block"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Permissions policy (restrict browser features)
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Strict Transport Security (HSTS) - force HTTPS for 1 year
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Remove server information
        -Server
    }

    # Rate limiting (requires rate limit plugin)
    # @ratelimit {
    #     not path /health
    # }
    # rate_limit @ratelimit {
    #     zone static 60r/m
    # }

    # Health check endpoint (no logging, public access)
    @health {
        path /health
    }
    handle @health {
        reverse_proxy localhost:{{APP_PORT}} {
            # Fast timeout for health checks
            timeout 5s
        }
    }

    # Static assets caching
    @static {
        path /_app/* /favicon.ico /robots.txt /sitemap.xml
        file
    }
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy localhost:{{APP_PORT}}
    }

    # Main application
    handle {
        reverse_proxy localhost:{{APP_PORT}} {
            # Connection settings
            transport http {
                # Keep connections alive
                keepalive 30s
                keepalive_idle_conns 10
            }

            # Timeouts
            timeout 30s
            dial_timeout 5s

            # Load balancing (if you have multiple app instances)
            # lb_policy random_choose 2

            # Health check
            health_uri /health
            health_interval 10s
            health_timeout 5s
            health_status 200

            # Pass client IP
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    # Access log (optional - comment out for better performance)
    log {
        output file /var/log/caddy/{{APP_NAME}}.access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 30d
        }
        format json
        level INFO
    }

    # Error log
    log {
        output file /var/log/caddy/{{APP_NAME}}.error.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 30d
        }
        format json
        level ERROR
    }
}

# Redirect www to non-www (optional)
www.{{DOMAIN}} {
    redir https://{{DOMAIN}}{uri} permanent
}

